; MuuCmf T6 应用配置模板（Docker 部署用）
;
; 使用方法：
;   cp .env.production.example .env
;   # 修改下面各值后，执行：docker compose --env-file .env.docker up -d
;
; 说明：该文件会被挂载进容器（./.env:/var/www/html/.env），是应用读取配置的
;      唯一来源；Database/Redis 的地址必须使用容器服务名（mysql / redis），
;      不能用 127.0.0.1（那是容器自身）。数据库账号需与 .env.docker 保持一致。

APP_DEBUG = false

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai

[DATABASE]
TYPE = mysql
HOSTNAME = mysql
DATABASE = muucmf
USERNAME = muucmf
PASSWORD = change_this_password
HOSTPORT = 3306
CHARSET = utf8
DEBUG = false
# 慢查询阈值（单位:毫秒）超过该时间会记录到日志
SLOW_LOG_TIME = 100
# 是否记录所有SQL（仅开发模式下生效）
LOG_ALL_SQL = false

[CACHE]
DRIVER = redis

[REDIS]
HOST = redis
PORT = 6379
password =
select = 0

[QUEUE]
NAME = default

[LANG]
default_lang = zh-cn

[JWT]
SECRET = change_this_secret

[GEO]
# GEO引擎 API Key 存储加密密钥（留空时回退使用 JWT.SECRET）
# 注意：修改该值会导致已存储的引擎 API Key 无法解密，需重新保存引擎配置
API_KEY_SECRET =