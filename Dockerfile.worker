FROM composer:2.5 AS composer

WORKDIR /app

COPY composer.json composer.lock ./
RUN composer install --prefer-dist --no-dev --no-autoloader --no-scripts --ignore-platform-req=ext-*

COPY . .
RUN composer dump-autoload --optimize --classmap-authoritative

FROM php:8.0-cli-alpine

WORKDIR /var/www/html

RUN apk add --no-cache \
    git \
    unzip \
    libzip-dev \
    libpng-dev \
    libjpeg-turbo-dev \
    freetype-dev \
    libxml2-dev \
    icu-dev \
    oniguruma-dev \
    autoconf \
    g++ \
    make \
    supervisor \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
        bcmath \
        exif \
        gd \
        intl \
        mbstring \
        mysqli \
        opcache \
        pdo \
        pdo_mysql \
        xml \
        zip \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && rm -rf /tmp/pear \
    && apk del --purge autoconf g++ make

COPY --from=composer /app /var/www/html

RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 755 /var/www/html \
    && mkdir -p /var/www/html/runtime \
    && mkdir -p /var/www/html/public/uploads \
    && chown -R www-data:www-data /var/www/html/runtime \
    && chown -R www-data:www-data /var/www/html/public/uploads

COPY docker/php/php.ini /usr/local/etc/php/conf.d/custom.ini
COPY docker/php/opcache.ini /usr/local/etc/php/conf.d/opcache.ini
COPY docker/worker/supervisord.conf /etc/supervisor/conf.d/supervisord.conf
COPY docker/worker/entrypoint.sh /var/www/html/docker/worker/entrypoint.sh

RUN apk add --no-cache dos2unix && dos2unix /var/www/html/docker/worker/entrypoint.sh && chmod +x /var/www/html/docker/worker/entrypoint.sh

EXPOSE 9000

CMD ["/var/www/html/docker/worker/entrypoint.sh"]
