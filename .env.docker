# Docker 编排变量（仅供 docker compose 插值使用）
#
# 用法：docker compose --env-file .env.docker up -d
#
# 本文件不是应用配置。应用读的是被挂载进容器的宿主 .env（INI 段格式，见
# .env.production.example），两者职责分离：
#   - .env.docker       → 容器编排：端口映射、MySQL 容器初始化账号
#   - .env（宿主）      → 应用运行时：连库 / 连 Redis 地址
# 注意：DB_DATABASE / DB_USERNAME / DB_PASSWORD 用于首次初始化 MySQL 容器，
#      请与宿主 .env 的 [DATABASE] 段保持一致，否则应用连不上数据库。

# 应用运行模式（仅编排层参考，应用自身以 .env 为准）
APP_ENV=production
APP_DEBUG=false

# Container User Mapping
# 与宿主 UID/GID 对齐，容器内 www-data 才能写入宿主卷（后台在线更新、应用安装的前提）
# 建议设置：PUID=$(id -u) PGID=$(id -g)
PUID=
PGID=

# MySQL 容器初始化（仅在数据卷首次创建时生效）
DB_DATABASE=muucmf
DB_USERNAME=muucmf
DB_PASSWORD=change_this_password
MYSQL_ROOT_PASSWORD=change_this_root_password

# 宿主发布端口（容器内端口固定：MySQL 3306 / Redis 6379 / Nginx 80,443）
MYSQL_PORT=3306
NGINX_PORT=80
NGINX_SSL_PORT=443
REDIS_HOST_PORT=6379

# Tools Configuration
PHPMYADMIN_PORT=8080
REDIS_COMMANDER_PORT=8081